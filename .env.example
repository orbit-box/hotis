# Telegram
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
TELEGRAM_CHANNEL_ID=@your_channel_username

# No paid economic-data API key required.
# TradingView public economic-calendar endpoint is used for US high-impact events.

TIMEZONE=Asia/Seoul
COUNTRY_CODE=US
MIN_IMPORTANCE=1
POLL_SECONDS=30
PRE_ALERT_MINUTES=30,5
DAILY_BRIEF_HOUR=9
DAILY_BRIEF_MINUTE=0
BTC_REACTION_DELAY_SECONDS=60

# Optional admin endpoint auth
ADMIN_SECRET=change-this-long-random-string

DB_PATH=/tmp/economic_bot.sqlite3
