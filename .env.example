# Telegram
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
TELEGRAM_CHANNEL_ID=@your_channel_username

# Trading Economics (https://developer.tradingeconomics.com/)
TRADING_ECONOMICS_API_KEY=REPLACE_ME

# Bot settings
TIMEZONE=Asia/Seoul
COUNTRY=United States
MIN_IMPORTANCE=3
POLL_SECONDS=30
PRE_ALERT_MINUTES=30,5
DAILY_BRIEF_HOUR=9
DAILY_BRIEF_MINUTE=0
BTC_REACTION_DELAY_SECONDS=60

# Optional: simple admin endpoint auth
ADMIN_SECRET=change-this-long-random-string

# Railway volume recommended: /data
DB_PATH=/data/economic_bot.sqlite3
